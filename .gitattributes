# Normalize line endings across operating systems.
# Git stores text as LF internally; developers on any OS get a consistent repo.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run correctly.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Data and binary assets: never apply EOL conversion.
*.csv    text eol=lf
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.db     binary
*.sqlite binary
*.ipynb  text eol=lf
